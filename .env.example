# Copy to .env and fill in the values from
# Firebase Console -> Project settings -> Your apps -> Web app config.
# All VITE_FIREBASE_* values are required — `npm run build` fails without them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: named Firestore database (this deployment uses "fiber-tracker").
# Leave empty for the default database.
VITE_FIRESTORE_DATABASE_ID=

# Team-lead (admin) allowlist, as comma-separated SHA-256 hashes of lowercased
# emails. Only matching accounts may create teams (become admins). The plaintext
# email never ships in the bundle. Leave empty to let anyone create a team.
# Generate a hash:  echo -n "someone@example.com" | sha256sum
VITE_TEAM_LEAD_HASHES=b17287bddc5630440d88617549fd75b9204cd66083a5c83bce6048aa49ec47c3

# Comma-separated email domains allowed to sign in and join teams.
# Any account outside these domains is signed out immediately.
# Leave empty to allow all domains.
VITE_ALLOWED_DOMAINS=telusinternational.com,telusdigital.com
