{
  "hosting": {
    "site": "gfiber-tracker",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "fiber-tracker",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
